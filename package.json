{
  "name": "resumegpt",
  "version": "2.0.0",
  "description": "Privacy-first resume and job-description analyzer with local skill matching and optional AI-powered feedback.",
  "private": true,
  "type": "module",
  "homepage": "https://robundy2002.github.io/ResumeGPT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
