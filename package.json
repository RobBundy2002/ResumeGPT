    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "keywords": [
    "resume",
    "resume-analyzer",
    "job-search",
    "react",
    "typescript",
    "vite",
    "openai",
    "privacy",
    "github-pages",
    "github-actions"
